# ── CareerOS Production Environment Variables ─────────────────────────────────
# Copy these into Render → Environment (never commit real values)

# App
APP_ENV=production
DEBUG=false
SECRET_KEY=80e20114ee6d78e63803b883c69de19e0f9fbb9bf96cdb046cc5b3dbcb0dcbf5
FRONTEND_URL=https://your-app.vercel.app
API_BASE_URL=https://careers-gjof.onrender.com
ALLOWED_ORIGINS=https://your-app.vercel.app

# Database (from Supabase → Settings → Database)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres

# Supabase (from Supabase → Settings → API)
SUPABASE_URL=https://[PROJECT].supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_ANON_KEY=eyJ...

# Auth (from Clerk → API Keys — use LIVE keys)
CLERK_SECRET_KEY=sk_live_...
CLERK_WEBHOOK_SECRET=whsec_...   # from Clerk → Webhooks

# AI
GEMINI_API_KEY=...
OPENROUTER_API_KEY=...           # optional

# Email (from Resend → API Keys)
RESEND_API_KEY=re_...
FROM_EMAIL=noreply@careeros.ai   # must be a verified domain in Resend
NOTIFY_EMAIL=your@email.com

# Admin
ADMIN_EMAILS=your@email.com

# Payments (from Razorpay → Settings — use LIVE keys)
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=...
RAZORPAY_PLAN_ID=plan_...
RAZORPAY_WEBHOOK_SECRET=...      # from Razorpay → Webhooks

# Job boards
ADZUNA_APP_ID=...
ADZUNA_APP_KEY=...

# Storage — Cloudflare R2 (optional; local fallback used if empty)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=careeros-resumes
R2_PUBLIC_URL=

# Cache — Redis (optional; in-memory fallback used if empty)
REDIS_URL=

# Monitoring (optional)
SENTRY_DSN=
