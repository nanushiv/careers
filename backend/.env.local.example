# ── MINIMUM REQUIRED FOR LOCAL DEV ──────────────────────────────────────────
# Fill these in to get the app running. Everything else is optional.

# 1. Supabase — create free project at supabase.com
DATABASE_URL=postgresql+asyncpg://postgres:password@db.your-project.supabase.co:5432/postgres
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...service-role-key-from-supabase-dashboard
SUPABASE_ANON_KEY=eyJ...anon-key-from-supabase-dashboard

# 2. Clerk — create free app at clerk.com
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# 3. Google AI — get key at aistudio.google.com (free tier works)
GEMINI_API_KEY=AIza...

# ── OPTIONAL (app works without these locally) ───────────────────────────────
REDIS_URL=redis://localhost:6379
OPENROUTER_API_KEY=
RESEND_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=careeros-resumes
R2_PUBLIC_URL=http://localhost:8000/files

APP_ENV=development
DEBUG=true
SECRET_KEY=local-dev-secret-key-change-in-prod
ALLOWED_ORIGINS=["http://localhost:3000"]
