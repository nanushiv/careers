# ── App ──────────────────────────────────────────────
APP_ENV=development                    # development | production
DEBUG=true
SECRET_KEY=your-secret-key-min-32-chars-change-in-prod
ALLOWED_ORIGINS=http://localhost:3000

# ── Database (Supabase) ──────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:[password]@db.[project].supabase.co:5432/postgres
SUPABASE_URL=https://[project].supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...      # Service role (server-side only)
SUPABASE_ANON_KEY=eyJ...              # Anon key

# ── Auth (Clerk) ─────────────────────────────────────
CLERK_SECRET_KEY=sk_live_...
CLERK_WEBHOOK_SECRET=whsec_...        # For webhook verification

# ── Cache (Upstash Redis) ────────────────────────────
REDIS_URL=rediss://:[password]@[host].upstash.io:6380

# ── File Storage (Cloudflare R2) ─────────────────────
R2_ACCOUNT_ID=abc123
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret
R2_BUCKET_NAME=careeros-resumes
R2_PUBLIC_URL=https://files.careeros.ai

# ── AI ───────────────────────────────────────────────
GEMINI_API_KEY=AIza...
OPENROUTER_API_KEY=sk-or-...
EMBEDDING_MODEL=models/text-embedding-004

# ── Email (Resend) ───────────────────────────────────
RESEND_API_KEY=re_...
FROM_EMAIL=noreply@careeros.ai

# ── Payments (Stripe) ────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_TEAM_PRICE_ID=price_...

# ── Analytics (PostHog) ──────────────────────────────
POSTHOG_API_KEY=phc_...
POSTHOG_HOST=https://app.posthog.com

# ── Error Tracking (Sentry) ──────────────────────────
SENTRY_DSN=https://...@sentry.io/...

# ── Rate Limits ──────────────────────────────────────
RATE_LIMIT_FREE_PER_MINUTE=20
RATE_LIMIT_PRO_PER_MINUTE=100

# ── AI Cost Limits ───────────────────────────────────
AI_BUDGET_FREE_MONTHLY_USD=0.15
AI_BUDGET_PRO_MONTHLY_USD=2.00

# Indeed Publisher ID (for job suggestions — get free at indeed.com/publisher)
INDEED_PUBLISHER_ID=
